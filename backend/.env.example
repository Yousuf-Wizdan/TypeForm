# Backend Environment Variables Template

# Database Connection
DATABASE_URL=sqlite:///./typeform.db

# FastAPI Secret Key
SECRET_KEY=your_secret_key_change_in_production

# CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Server Host & Port
HOST=127.0.0.1
PORT=8000
